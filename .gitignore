
# Slop Studio — Git Ignore

# Build outputs
/build/
/dist/
bin/
obj/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log

# Compiler artifacts
*.obj
*.pdb
*.ilk
*.idb
*.pch
*.ipch
*.tlog

# IDE and editor files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Python cache
__pycache__/
*.py[cod]

# Temporary files and logs
*.tmp
*.log

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local user projects and application data
/projects/
/user-data/
