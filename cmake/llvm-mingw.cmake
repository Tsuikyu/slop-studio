list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_MINGW_ROOT)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT LLVM_MINGW_ROOT)
 message(FATAL_ERROR "Set LLVM_MINGW_ROOT to the extracted llvm-mingw x86-64 directory.")
endif()
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/clang.exe")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/clang++.exe")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/llvm-windres.exe")
set(CMAKE_CXX_FLAGS_INIT "-Xclang -fno-temp-file")
